---
- name: Ensure install script exists
  copy:
    src: files/install.sh
    dest: /opt/controlm/install.sh
    mode: '0755'

- name: Run Control-M Agent install script
  command: >
    /opt/controlm/install.sh
    --agent-name {{ agent_name }}
    --controlm-server {{ controlm_server }}
    --controlm-port {{ controlm_port }}
  register: install_output

- debug:
    msg: "{{ install_output.stdout_lines }}"

- name: Configure Control-M Agent
  template:
    src: agent_config.j2
    dest: /opt/controlm/ctm/data/CONFIG.dat
    mode: '0644'

- name: Start Control-M Agent service
  systemd:
    name: controlm-agent
    state: started
    enabled: yes
